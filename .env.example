# Frontend Environment Variables (apps/web/.env.example)
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=local-dev-api-key
VITE_FIREBASE_AUTH_DOMAIN=smart-attendance-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-attendance-dev
VITE_FIREBASE_STORAGE_BUCKET=smart-attendance-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_INSTITUTION_TIMEZONE=Asia/Kolkata

# Functions Environment Variables
DEVICE_SECRET_SALT=local-device-salt-change-in-prod
ADMIN_INITIAL_EMAIL=admin@attendance.local
ADMIN_INITIAL_PASSWORD=AdminPass123!
