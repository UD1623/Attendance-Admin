{
  "name": "smart-attendance-system",
  "version": "1.0.0",
  "private": true,
  "description": "Fingerprint Attendance Management Dashboard with authoritative Cloud Functions backend",
  "workspaces": [
    "apps/web",
    "functions",
    "tools/device-simulator"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:functions": "npm run build --workspace=functions",
    "build": "npm run build:web && npm run build:functions",
    "test:web": "npm run test --workspace=apps/web",
    "test:functions": "npm run test --workspace=functions",
    "test": "npm run test:web && npm run test:functions",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "typecheck:functions": "npm run typecheck --workspace=functions",
    "typecheck": "npm run typecheck:web && npm run typecheck:functions",
    "lint": "npm run lint --workspace=apps/web",
    "emulators": "firebase emulators:start --only auth,firestore,functions,hosting",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "seed": "npx tsx tools/seed/bootstrap-admin.ts",
    "simulator": "npm run start --workspace=tools/device-simulator"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "firebase-tools": "^13.31.0",
    "typescript": "^5.7.3"
  }
}
